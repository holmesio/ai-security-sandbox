# Copy to .env for local dev. NEVER commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
LLM_DEFAULT_MODEL=claude-sonnet-5
LLM_REQUEST_TIMEOUT_S=30

# --- Redis (rate limiters) ---
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=aiss

# --- Qdrant (RAG vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aiss_docs

# --- Budget / abuse controls ---
# Per-principal rolling spend cap (USD) enforced by the cost-based limiter.
COST_LIMIT_USD_PER_HOUR=2.00
COST_LIMIT_USD_PER_DAY=20.00
# Hard ceiling on tokens accepted from a single request (pre-flight reject).
MAX_INPUT_TOKENS_PER_REQUEST=12000
